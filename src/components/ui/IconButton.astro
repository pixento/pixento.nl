---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  icon: string;
  label: string;
  variant?: 'ghost' | 'outline' | 'primary' | 'dark';
  size?: 'sm' | 'md' | 'lg';
}

const { icon, label, variant = 'ghost', size = 'md', href, class: className, ...rest } = Astro.props;

const sizes = {
  sm: { box: 'size-8', icon: 'size-3.5' },
  md: { box: 'size-10', icon: 'size-4.5' },
  lg: { box: 'size-12', icon: 'size-5' },
};
const variants = {
  ghost: 'bg-transparent text-ink-800 border-transparent hover:bg-ink-100 hover:text-ink-800',
  outline: 'bg-white text-ink-900 border-ink-300 hover:bg-ink-50 hover:text-ink-900',
  primary: 'bg-primary text-white border-transparent hover:bg-primary-hover hover:text-white',
  dark: 'bg-ink-900 text-white border-transparent hover:bg-surface-dark-raised hover:text-white',
};
const classes = [
  'inline-flex items-center justify-center rounded-sm border p-0 cursor-pointer transition-colors duration-120 ease-out',
  sizes[size].box,
  variants[variant],
  className,
];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : 'button'} aria-label={label} title={label} class:list={classes} {...rest}>
  <Icon name={`lucide:${icon}`} class={sizes[size].icon} aria-hidden="true" />
</Tag>
