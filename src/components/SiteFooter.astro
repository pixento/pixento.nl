---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo-white.svg';
import IconButton from './ui/IconButton.astro';
import LangSwitch from './LangSwitch.astro';
import { isTodo, pagePath, useTranslations, type Lang, type Page } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
}
const { lang, paths } = Astro.props;
const t = useTranslations(lang);
const nav: Page[] = ['home', 'work', 'contact'];
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-surface-dark text-ink-400">
  <div class="mx-auto grid max-w-content gap-10 px-6 pt-14 pb-8 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <Image src={logoWhite} alt="Pixento" class="h-13 w-auto" />
      <p class="mt-4 max-w-85 text-sm">{t.footer.blurb}</p>
    </div>
    <div class="flex flex-col gap-2 text-sm">
      <b class="mb-1 text-white">{t.footer.site}</b>
      {nav.map((page) => <a href={pagePath(page, lang)} class="text-ink-300 no-underline hover:text-white">{t.nav[page]}</a>)}
    </div>
    <div class="flex flex-col gap-2 text-sm">
      <b class="mb-1 text-white">{t.footer.elsewhere}</b>
      <div class="flex gap-2">
        {/* TODO: GitHub-link toevoegen in src/data/site.ts */}
        {!isTodo(site.github) && <IconButton icon="github" label="GitHub" variant="dark" href={site.github} />}
        <IconButton icon="linkedin" label="LinkedIn" variant="dark" href={site.linkedin} target="_blank" rel="noopener" />
        {!isTodo(site.email) && <IconButton icon="mail" label="E-mail" variant="dark" href={`mailto:${site.email}`} />}
      </div>
      <span class="mt-2 font-mono text-xs">KvK {site.kvk}</span>
      <div class="mt-2 self-start"><LangSwitch lang={lang} paths={paths} label={t.langLabel} dark /></div>
    </div>
  </div>
  <div class="mx-auto flex max-w-content flex-wrap justify-between gap-2 border-t border-ink-800 px-6 pt-4 pb-6 text-xs">
    <span>© {year} Pixento</span>
    <span class="font-mono">{t.footer.tag}</span>
  </div>
</footer>
