---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  variant?: 'default' | 'block' | 'sunken' | 'dark';
  /** Lift on hover; renders an <a> when `href` is set. */
  interactive?: boolean;
  href?: string;
}

const { variant = 'default', interactive, href, class: className, ...rest } = Astro.props;

const variants = {
  default: 'bg-surface-card border border-line text-fg',
  block: 'bg-surface-card border-2 border-ink-800 shadow-block text-fg',
  sunken: 'bg-surface-sunken border border-transparent text-fg',
  dark: 'bg-surface-dark border border-surface-dark text-fg-on-dark',
};
const hover = interactive
  ? variant === 'block'
    ? 'cursor-pointer hover:-translate-0.5 hover:shadow-block-lg'
    : 'cursor-pointer hover:shadow-md'
  : '';

const classes = [
  'block rounded-md p-6 transition-[box-shadow,translate] duration-180 ease-out',
  variants[variant],
  hover,
  href && 'no-underline hover:no-underline hover:text-fg',
  className,
];
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={classes} {...rest}><slot /></Tag>
