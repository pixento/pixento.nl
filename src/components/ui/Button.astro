---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  variant?: 'primary' | 'secondary' | 'blue' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  iconLeft?: string;
  iconRight?: string;
  fullWidth?: boolean;
  type?: 'button' | 'submit';
}

const { variant = 'primary', size = 'md', iconLeft, iconRight, fullWidth, href, type = 'button', class: className, ...rest } = Astro.props;

const sizes = {
  sm: { box: 'h-8 px-3 text-sm', icon: 'size-3.5' },
  md: { box: 'h-10 px-4 text-ui', icon: 'size-4' },
  lg: { box: 'h-12 px-5.5 text-md', icon: 'size-4.5' },
};
const variants = {
  primary: 'bg-primary text-white border-transparent hover:bg-primary-hover active:translate-y-px',
  secondary: 'bg-white text-ink-900 border-ink-800 shadow-block-sm hover:-translate-0.5 hover:shadow-block active:translate-0.5 active:shadow-none',
  blue: 'bg-blue-600 text-white border-transparent hover:bg-blue-700 active:translate-y-px',
  ghost: 'bg-transparent text-ink-800 border-transparent hover:bg-ink-100 active:translate-y-px',
};

const classes = [
  fullWidth ? 'flex w-full' : 'inline-flex',
  'items-center justify-center gap-2 rounded-sm border-2 font-sans font-bold leading-none tracking-[.01em] whitespace-nowrap no-underline',
  'transition-[background-color,box-shadow,translate] duration-120 ease-out cursor-pointer',
  'hover:no-underline',
  sizes[size].box,
  variants[variant],
  variant === 'primary' || variant === 'blue' ? 'hover:text-white' : 'hover:text-ink-900',
  className,
];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : type} class:list={classes} {...rest}>
  {iconLeft && <Icon name={`lucide:${iconLeft}`} class={sizes[size].icon} aria-hidden="true" />}
  <slot />
  {iconRight && <Icon name={`lucide:${iconRight}`} class={sizes[size].icon} aria-hidden="true" />}
</Tag>
