---
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  title: string;
  body?: string;
}
const { id, title, body } = Astro.props;
---

<div
  id={id}
  role="status"
  hidden
  class="fixed right-4 bottom-4 z-110 flex w-90 max-w-[calc(100%-2rem)] items-start gap-3 rounded-md bg-surface-dark p-3 text-fg-on-dark shadow-lg sm:right-6 sm:bottom-6"
>
  <span class="inline-flex size-7 flex-none items-center justify-center rounded-xs bg-green-600">
    <Icon name="lucide:check" class="size-4 text-white" aria-hidden="true" />
  </span>
  <div class="min-w-0 flex-1 pt-0.75">
    <div class="text-sm leading-[1.3] font-bold">{title}</div>
    {body && <div class="mt-0.5 text-[13px] text-ink-400">{body}</div>}
  </div>
</div>
