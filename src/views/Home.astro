---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Overline from '../components/ui/Overline.astro';
import Tag from '../components/ui/Tag.astro';
import Wrap from '../components/ui/Wrap.astro';
import { pagePath, tr, useTranslations, type Lang } from '../i18n/ui';
import { availability, stats } from '../data/site';
import { services } from '../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = useTranslations(lang);
const t = T.home;
const [planHead, done1, done2, todo1, todo2, planQuote] = t.plan;
---

<Base lang={lang} title={t.title} current="home">
  <Wrap class="grid items-center gap-14 pt-14 pb-16 md:pt-22 md:pb-18 lg:grid-cols-[1.25fr_1fr]">
    <div>
      <Badge tone="success" dot>{availability[lang]}</Badge>
      <h1 class="mt-5 text-[56px] leading-[.95] sm:text-display-l lg:text-display-xl">
        {t.h1a}<br />
        <span class="box-decoration-clone bg-orange-500 px-[.12em] text-white">{t.h1b}</span>
      </h1>
      <p class="mt-6 max-w-135 text-lead text-fg">{t.lede}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button size="lg" iconRight="arrow-right" href={pagePath('contact', lang)}>{T.cta}</Button>
        <Button size="lg" variant="secondary" href={pagePath('work', lang)}>{t.seeWork}</Button>
      </div>
    </div>
    <Card variant="dark" class="overflow-hidden p-0! shadow-block-orange">
      <div class="flex gap-1.5 border-b border-ink-800 px-4 py-3">
        <i class="size-2.5 bg-orange-500"></i><i class="size-2.5 bg-blue-500"></i><i class="size-2.5 bg-ink-600"></i>
        <span class="ml-auto font-mono text-[11px] text-ink-500">plan.md</span>
      </div>
      <pre class="m-0 px-5 pt-5 pb-6 text-sm leading-[1.75] whitespace-pre-wrap text-ink-200">{planHead + '\n'}<span class="text-blue-300">- [x]</span>{done1 + '\n'}<span class="text-blue-300">- [x]</span>{done2 + '\n'}<span class="text-orange-300">- [ ]</span>{todo1 + '\n'}<span class="text-orange-300">- [ ]</span>{todo2 + '\n\n'}<span class="text-ink-500">{planQuote}</span></pre>
    </Card>
  </Wrap>

  <div class="border-y border-line bg-surface-card">
    <Wrap class="grid sm:grid-cols-3">
      {
        stats[lang].map(([n, l]) => (
          <div class="border-line py-7 max-sm:not-first:border-t sm:px-6 sm:not-first:border-l">
            <div class="font-display text-display-m font-bold">{n}</div>
            <div class="mt-1 text-sm text-fg-muted">{l}</div>
          </div>
        ))
      }
    </Wrap>
  </div>

  <Wrap class="pt-24">
    <Overline>{t.whatOver}</Overline>
    <h2 class="mt-2 max-w-170 text-[44px] sm:text-display-m">{t.whatH}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        services.map((s) => (
          <Card class="flex flex-col gap-3">
            <span class="inline-flex size-12 items-center justify-center rounded-sm bg-orange-100">
              <Icon name={`lucide:${s.icon}`} class="size-6 text-orange-600" aria-hidden="true" />
            </span>
            <h3 class="text-[30px]">{tr(s.title, lang)}</h3>
            <p class="text-ui">{tr(s.body, lang)}</p>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
              {tr(s.tags, lang).map((tag) => <Tag>{tag}</Tag>)}
            </div>
          </Card>
        ))
      }
    </div>
  </Wrap>

  <Wrap class="pt-24">
    <Card class="grid items-center gap-8 border-blue-200! p-8 shadow-block-blue sm:p-12 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-[48px] leading-[1.05]">{t.ctaH}</h2>
        <p class="mt-2 text-[18px]">{t.ctaP}</p>
      </div>
      <Button size="lg" iconRight="calendar" href={pagePath('contact', lang)} class="justify-self-start">{T.cta}</Button>
    </Card>
  </Wrap>
</Base>
